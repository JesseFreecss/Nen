<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifeste de l'application : déclare les composants (activités, services...),
    les permissions et les métadonnées. Le package effectif vient de `namespace`
    dans build.gradle.kts, donc pas d'attribut package= ici.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Accès réseau : relais des requêtes DNS vers le résolveur externe. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Service au premier plan (le VPN doit tourner en foreground). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Afficher la notification de protection (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GardeFou">

        <!-- Activité de lancement : c'est l'écran ouvert au démarrage de l'app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GardeFou">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Service VPN. La permission BIND_VPN_SERVICE est imposée par le système :
            seul Android peut lier ce service (sécurité). Le type "specialUse" satisfait
            l'exigence de type de service au premier plan sur Android 14+.
        -->
        <service
            android:name=".vpn.GardeFouVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN local de filtrage DNS pour contrôle de contenu personnel" />
        </service>
    </application>

</manifest>
