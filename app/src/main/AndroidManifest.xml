<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifeste de l'application : déclare les composants (activités, services...),
    les permissions et les métadonnées. Le package effectif vient de `namespace`
    dans build.gradle.kts, donc pas d'attribut package= ici.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Accès réseau : relais des requêtes DNS vers le résolveur externe. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Service au premier plan (le VPN doit tourner en foreground). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Afficher la notification de protection (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Demander l'exclusion des optimisations de batterie. Sans elle, le système place l'app
        dans un « bucket » restreint après quelques heures d'inactivité et tue le service VPN,
        ce qui désactive la protection sans prévenir.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Relancer la protection après un redémarrage du téléphone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nen">

        <!-- Activité de lancement : c'est l'écran ouvert au démarrage de l'app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Service VPN. La permission BIND_VPN_SERVICE est imposée par le système :
            seul Android peut lier ce service (sécurité). Le type "specialUse" satisfait
            l'exigence de type de service au premier plan sur Android 14+.
        -->
        <service
            android:name=".vpn.NenVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN local de filtrage DNS pour contrôle de contenu personnel" />
        </service>

        <!--
            Minuteur Pomodoro. Service au premier plan pour que le décompte survive au passage
            dans une autre application. Aucun type d'usage prédéfini d'Android 14+ ne couvre un
            minuteur long (shortService est plafonné à quelques minutes), d'où "specialUse".
        -->
        <service
            android:name=".pomodoro.PomodoroService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Minuteur Pomodoro lancé par l'utilisateur, dont le décompte doit se poursuivre en arrière-plan" />
        </service>

        <!--
            Service d'accessibilité (étape 3). La permission BIND_ACCESSIBILITY_SERVICE est
            imposée par le système : seul Android peut lier ce service. L'utilisateur doit
            l'activer manuellement dans Réglages > Accessibilité. La config (apps surveillées,
            types d'événements) est dans @xml/accessibility_service_config.
        -->
        <service
            android:name=".accessibility.NenAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            Relance la protection au démarrage du téléphone. exported="true" est obligatoire :
            c'est le système (un process externe) qui envoie BOOT_COMPLETED.
            directBootAware reste à false car on lit les SharedPreferences, inaccessibles
            avant le premier déverrouillage.
        -->
        <receiver
            android:name=".vpn.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
