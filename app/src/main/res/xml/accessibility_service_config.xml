<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration du service d'accessibilité Nen.

    - accessibilityEventTypes : changements d'état/contenu de fenêtre (nouvelle page/URL)
      + typeViewTextChanged, qui donne le texte DÈS LA FRAPPE dans la barre d'adresse et
      permet de bloquer avant la validation de la recherche. Pas tous les événements.
    - packageNames : LISTE BLANCHE. Le système ne nous enverra d'événements QUE pour ces
      apps (navigateurs, app Google, YouTube, Instagram). Aucune autre app n'est observée.
      L'app Google (googlequicksearchbox) est celle qui s'ouvre depuis le widget de
      recherche de l'écran d'accueil : sans elle, une recherche lancée de là passait
      entièrement sous le radar. Instagram n'est observée que pour détecter les Reels
      (limite de temps quotidienne), aucun champ de saisie n'y est lu.
    - canRetrieveWindowContent + flagReportViewIds : nécessaires pour lire l'arbre de vues
      et retrouver les nœuds par resource-id (barre d'adresse, marqueurs Shorts).
    - notificationTimeout : délai anti-rebond entre deux événements. Volontairement court
      (50 ms) : à 300 ms, le mot tapé était reconnu trop tard, après le chargement de la page.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="50"
    android:packageNames="com.android.chrome,com.chrome.beta,com.google.android.youtube,com.google.android.googlequicksearchbox,org.mozilla.firefox,com.brave.browser,com.microsoft.emmx,com.opera.browser,com.opera.mini.native,com.sec.android.app.sbrowser,com.duckduckgo.mobile.android,com.vivaldi.browser,com.kiwibrowser.browser,com.instagram.android" />
